---
// /reference/ has no content page of its own; send readers to the index.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/reference/commands/`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${to}`} />
		<link rel="canonical" href={to} />
		<title>Every command | aos</title>
		<meta name="description" content="The aos command reference, one page per group." />
	</head>
	<body>
		<p>Redirecting to <a href={to}>the command reference</a>.</p>
	</body>
</html>
